// Neon Siren: UI theme (pure black, hot red-pink and cyan-blue at full saturation).
// Keys are OpenIDEA's CSS variables; delete a line to keep the base "dark" value.
{
  "id": "neon-siren",
  "name": "Neon Siren",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#000000",
    "--bg-elev": "#0b0a10",
    "--bg-popup": "#100e15",
    "--bg-floating-toolbar": "#100e15",
    "--bg-hover": "#15121a",
    "--bg-selected": "#3d0f22",
    "--bg-selected-strong": "#4e122b",
    "--bg-current-line": "#0b0a10",
    "--bg-debug-line": "#0d3550",
    "--bg-backdrop": "#100e15",
    "--bg-input": "#000000",

    // Lines
    "--border": "#120f17",
    "--border-popup": "#1d1824",
    "--border-strong": "#2a2232",
    "--border-window": "#2a2232",
    "--control-off": "#4d4760",

    // Text
    "--fg-strong": "#ffffff",
    "--fg-emphasis": "#ebe7f5",
    "--fg": "#d6d3e0",
    "--fg-secondary": "#958fa8",
    "--fg-muted": "#7d7790",
    "--fg-subtle": "#665f7a",
    "--fg-faint": "#4d4760",
    "--fg-gutter": "#3a344a",
    "--fg-icon": "#d0cce0",

    // Accent
    "--accent": "#ff2d55",
    "--link": "#22d3ff",
    "--link-hover": "#7ee6ff",

    // Charts
    "--chart-series": "#ff2d55",

    // Status
    "--danger": "#ff2d55",
    "--warning": "#ffd23f",
    "--success": "#3dffa8",
    "--db-connected": "#3dffa8",
    "--db-connected-ring": "#127a4c",
    "--info": "#22d3ff",

    // Vcs
    "--vcs-modified": "#22d3ff",
    "--vcs-added": "#3dffa8",
    "--vcs-deleted": "#7d7790",
    "--vcs-untracked": "#ff7aa2",
    "--vcs-ignored": "#b08a5c",
    "--vcs-conflict": "#ff2d55",
    "--gutter-modified": "#1a9fc2",
    "--gutter-added": "#21b877",
    "--gutter-deleted": "#7d7790",
    "--diff-modified": "#06283a",
    "--diff-inserted": "#062c1c",
    "--diff-deleted": "#330a18",
    "--diff-modified-stripe": "#1a9fc2",
    "--diff-inserted-stripe": "#21b877",
    "--diff-deleted-stripe": "#7d7790",
    "--diff-conflict-stripe": "#8f1a35",
    "--diff-separator-wave": "var(--fg-subtle)",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.6)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.8), 0 10px 24px rgba(0, 0, 0, 0.5), 0 24px 72px rgba(0, 0, 0, 0.6)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#2a2232",
    "--traffic-off-border": "#1d1824",

    // Additive
    "--bg-stripe-tooltip": "var(--bg-tooltip)",
    "--fg-stripe-tooltip": "var(--fg-tooltip)",
    "--border-stripe-tooltip": "var(--border-tooltip)",
    "--shadow-stripe-tooltip": "var(--shadow-tooltip)",
    "--bg-tooltip": "#1d1824",
    "--fg-tooltip": "#ebe7f5",
    "--border-tooltip": "#2a2232",
    "--bg-control": "#100e15",
    "--bg-control-hover": "#1d1824",
    "--bg-active": "#2a2232",
    "--bg-scrim": "rgba(0, 0, 0, 0.6)",
    "--fg-on-accent": "#ffffff",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.55)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.6)",

    // Islands contract
    "--bg-frame": "#07070a",
    "--bg-island": "#000000",
    "--bg-stripe-hover": "#ffffff14",
    "--bg-stripe-selected": "#ff2d5526",
    "--fg-stripe-selected-active": "#ffffff",
    "--fg-stripe-label": "#958fa8",
    "--bg-tab-selected": "#1a0a12",
    "--border-tab-selected": "#ff2d55",
    "--bg-tab-selected-inactive": "#100e15",
    "--border-tab-selected-inactive": "#2a2232",
    "--bg-tab-hover": "#ffffff14",
    "--border-editor-tabs": "#120f17",
    "--bg-tree-selected": "#3d0f22",
    "--bg-tree-selected-inactive": "#1d1824",
    "--bg-tree-hover": "#ffffff0d",
    "--bg-toolbar-hover": "#ffffff14",
    "--bg-toolbar-pressed": "#ffffff24",
    "--bg-toolbar-selected": "#4e122b",
    "--bg-toolbar-selected-hover": "#5f1634",
    "--bg-button-primary-hover": "#ff4f71",
    "--fg-button-primary": "#ffffff",
    "--bg-button": "transparent",
    "--border-button": "#2a2232",
    "--bg-field": "#000000",
    "--bg-checkbox": "#000000",
    "--border-checkbox": "#4d4760",
    "--bg-toggle-on": "#ff2d55",
    "--fg-toggle-on": "#ffffff",
    "--bg-toggle-off": "#000000",
    "--fg-toggle-off": "#665f7a",
    "--border-toggle": "#4d4760",
    "--bg-toggle-knob": "#4d4760",
    "--focus-ring-soft": "#8f1a35",
    "--scrollbar-thumb": "#ffffff2e",
    "--scrollbar-thumb-hover": "#ffffff52",
    "--bg-search-match": "#c9a21f",
    "--bg-search-match-current": "#ffd23f",
    "--fg-search-match": "#000000",
    "--bg-dialog": "#000000",
    "--bg-popup-inline": "#100e15",
    "--bg-popup-advertiser": "#100e15",
    "--bg-feedback-info": "#06283a",
    "--border-feedback-info": "#0f5a7a",
    "--bg-feedback-error": "#330a18",
    "--border-feedback-error": "#6e1530",
    "--bg-feedback-warning": "#332a08",
    "--border-feedback-warning": "#6e5a12",
    "--bg-feedback-success": "#062c1c",
    "--border-feedback-success": "#12603d",
    "--bg-counter": "#665f7a",
    "--fg-counter": "#000000",
    "--bg-progress-track": "#2a2232"
  }
}
