// Crimson Cobalt: UI theme (near-black surfaces, a crimson UI accent and electric blue code structure).
// Keys are OpenIDEA's CSS variables; delete a line to keep the base "dark" value.
{
  "id": "crimson-cobalt",
  "name": "Crimson Cobalt",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#09090c",
    "--bg-elev": "#111116",
    "--bg-popup": "#16161c",
    "--bg-floating-toolbar": "#16161c",
    "--bg-hover": "#1a1a21",
    "--bg-selected": "#3a1820",
    "--bg-selected-strong": "#4a1d28",
    "--bg-current-line": "#111116",
    "--bg-debug-line": "#1f3157",
    "--bg-backdrop": "#16161c",
    "--bg-input": "#09090c",

    // Lines
    "--border": "#16161c",
    "--border-popup": "#22222a",
    "--border-strong": "#2c2c35",
    "--border-window": "#2c2c35",
    "--control-off": "#4a4a56",

    // Text
    "--fg-strong": "#f0f0f4",
    "--fg-emphasis": "#dcdce4",
    "--fg": "#c9c9d2",
    "--fg-secondary": "#8e8e9c",
    "--fg-muted": "#7a7a88",
    "--fg-subtle": "#636371",
    "--fg-faint": "#4a4a56",
    "--fg-gutter": "#3a3a46",
    "--fg-icon": "#c4c4ce",

    // Accent
    "--accent": "#e23a4e",
    "--link": "#6fa8ff",
    "--link-hover": "#9cc3ff",

    // Charts
    "--chart-series": "#e23a4e",

    // Status
    "--danger": "#ff4d61",
    "--warning": "#e0a145",
    "--success": "#5fcf87",
    "--db-connected": "#5fcf87",
    "--db-connected-ring": "#1f6b3c",
    "--info": "#5b9bff",

    // Vcs
    "--vcs-modified": "#6fa8ff",
    "--vcs-added": "#5fcf87",
    "--vcs-deleted": "#7a7a88",
    "--vcs-untracked": "#ff8a96",
    "--vcs-ignored": "#c08a5c",
    "--vcs-conflict": "#ff4d61",
    "--gutter-modified": "#3e6fc4",
    "--gutter-added": "#3e9a5e",
    "--gutter-deleted": "#7a7a88",
    "--diff-modified": "#16264a",
    "--diff-inserted": "#14301f",
    "--diff-deleted": "#33181d",
    "--diff-modified-stripe": "#3e6fc4",
    "--diff-inserted-stripe": "#3e9a5e",
    "--diff-deleted-stripe": "#7a7a88",
    "--diff-conflict-stripe": "#8a2a36",
    "--diff-separator-wave": "var(--fg-subtle)",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.6)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.8), 0 10px 24px rgba(0, 0, 0, 0.5), 0 24px 72px rgba(0, 0, 0, 0.6)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#2c2c35",
    "--traffic-off-border": "#22222a",

    // Additive
    "--bg-stripe-tooltip": "var(--bg-tooltip)",
    "--fg-stripe-tooltip": "var(--fg-tooltip)",
    "--border-stripe-tooltip": "var(--border-tooltip)",
    "--shadow-stripe-tooltip": "var(--shadow-tooltip)",
    "--bg-tooltip": "#22222a",
    "--fg-tooltip": "#dcdce4",
    "--border-tooltip": "#2c2c35",
    "--bg-control": "#16161c",
    "--bg-control-hover": "#22222a",
    "--bg-active": "#2c2c35",
    "--bg-scrim": "rgba(0, 0, 0, 0.6)",
    "--fg-on-accent": "#ffffff",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.55)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.6)",

    // Islands contract
    "--bg-frame": "#0e0e12",
    "--bg-island": "#09090c",
    "--bg-stripe-hover": "#ffffff14",
    "--bg-stripe-selected": "#ffffff1f",
    "--fg-stripe-selected-active": "#ffffff",
    "--fg-stripe-label": "#8e8e9c",
    "--bg-tab-selected": "#1d1216",
    "--border-tab-selected": "#e23a4e",
    "--bg-tab-selected-inactive": "#16161c",
    "--border-tab-selected-inactive": "#2c2c35",
    "--bg-tab-hover": "#ffffff14",
    "--border-editor-tabs": "#16161c",
    "--bg-tree-selected": "#3a1820",
    "--bg-tree-selected-inactive": "#22222a",
    "--bg-tree-hover": "#ffffff0d",
    "--bg-toolbar-hover": "#ffffff14",
    "--bg-toolbar-pressed": "#ffffff24",
    "--bg-toolbar-selected": "#4a1d28",
    "--bg-toolbar-selected-hover": "#5a2330",
    "--bg-button-primary-hover": "#ec5466",
    "--fg-button-primary": "#ffffff",
    "--bg-button": "transparent",
    "--border-button": "#2c2c35",
    "--bg-field": "#09090c",
    "--bg-checkbox": "#09090c",
    "--border-checkbox": "#4a4a56",
    "--bg-toggle-on": "#e23a4e",
    "--fg-toggle-on": "#ffffff",
    "--bg-toggle-off": "#09090c",
    "--fg-toggle-off": "#636371",
    "--border-toggle": "#4a4a56",
    "--bg-toggle-knob": "#4a4a56",
    "--focus-ring-soft": "#7a2a35",
    "--scrollbar-thumb": "#ffffff2e",
    "--scrollbar-thumb-hover": "#ffffff52",
    "--bg-search-match": "#c98a2e",
    "--bg-search-match-current": "#ffb547",
    "--fg-search-match": "#09090c",
    "--bg-dialog": "#09090c",
    "--bg-popup-inline": "#16161c",
    "--bg-popup-advertiser": "#16161c",
    "--bg-feedback-info": "#152645",
    "--border-feedback-info": "#25447a",
    "--bg-feedback-error": "#3a151b",
    "--border-feedback-error": "#6a2430",
    "--bg-feedback-warning": "#3a2a12",
    "--border-feedback-warning": "#664a1c",
    "--bg-feedback-success": "#12301e",
    "--border-feedback-success": "#1f5534",
    "--bg-counter": "#636371",
    "--fg-counter": "#000000",
    "--bg-progress-track": "#2c2c35"
  }
}
